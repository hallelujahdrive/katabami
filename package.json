	"description": "Katabami is a JSON decoding library",
	"devDependencies": {
		"@biomejs/biome": "^2.4.13",
		"@types/bun": "^1.3.10",
		"@typescript-eslint/parser": "^8.57.1",
		"cspell": "^9.7.0",
		"dpdm": "^4.0.1",
		"eslint": "^10.0.3",
		"eslint-plugin-perfectionist": "^5.7.0",
		"husky": "^9.1.7",
		"i18next": "^25.8.18",
		"lint-staged": "^16.4.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.0"
	},
	"homepage": "https://github.com/hallelujahdrive/katabami#readme",
	"license": "WTFPL",
	"main": "index.js",
	"name": "katabami",
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/hallelujahdrive/katabami.git"
	},
	"scripts": {
		"check": "biome check . && eslint .",
		"check:fix": "biome check --write . && eslint . --fix",
		"dpdm": "dpdm --exit-code circular:1 src",
		"format": "biome format . && eslint .",
		"format:fix": "biome format --write . && eslint . --fix",
		"lint": "biome lint . && eslint .",
		"lint:fix": "biome lint --write . && eslint . --fix",
		"prepare": "husky",
		"test": "vitest",
		"test:typecheck": "vitest --typecheck",
		"types:check": "tsc --noEmit --pretty"
	},
	"type": "module",
	"version": "0.0.0"
