{
	"author": "hallelujahdrive",
	"bugs": {
		"url": "https://github.com/hallelujahdrive/katabami/issues"
	},
	"description": "Katabami is a JSON decoding library",
	"devDependencies": {
		"@eslint/json": "2.1.1",
		"@types/node": "^26.6.6",
		"cspell": "^10.4.0",
		"dpdm": "^4.3.0",
		"eslint": "10.13.0",
		"eslint-plugin-perfectionist": "5.13.0",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"homepage": "https://github.com/hallelujahdrive/katabami#readme",
	"keywords": [
		"combinator",
		"decoder",
		"json",
		"monorepo",
		"standard-schema",
		"typescript"
	],
	"license": "WTFPL",
	"name": "katabami-monorepo",
	"packageManager": "pnpm@11.20.0",
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/hallelujahdrive/katabami.git"
	},
	"scripts": {
		"build": "pnpm --filter katabami run build && pnpm --filter '@katabami/*' run build",
		"build:test": "pnpm --filter katabami run build:test && pnpm --filter '@katabami/*' run build:test",
		"check": "oxlint --max-warnings=0 --report-unused-disable-directives && oxfmt --check && eslint .",
		"check:fix": "oxlint --fix --max-warnings=0 --report-unused-disable-directives && oxfmt && eslint . --fix",
		"dpdm": "dpdm --exit-code circular:1 \"packages/*/src/index.ts\"",
		"format": "oxfmt --check && eslint .",
		"format:fix": "oxfmt && eslint . --fix",
		"lint": "oxlint --max-warnings=0 --report-unused-disable-directives && eslint .",
		"lint:fix": "oxlint --fix --max-warnings=0 --report-unused-disable-directives && eslint . --fix",
		"prepare": "husky",
		"release": "node scripts/release.mjs",
		"test": "pnpm --filter './packages/*' run test",
		"test:typecheck": "pnpm --filter './packages/*' run test:typecheck",
		"types:check": "tsc --noEmit --pretty"
	},
	"type": "module",
	"version": "0.4.1"
}
