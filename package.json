{
	"author": "hallelujahdrive",
	"bugs": {
		"url": "https://github.com/hallelujahdrive/katabami/issues"
	},
	"description": "Katabami is a JSON decoding library",
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/node": "^24.2.0",
		"@typescript-eslint/parser": "8.66.0",
		"cspell": "^10.0.1",
		"dpdm": "^4.3.0",
		"eslint": "10.8.1",
		"eslint-plugin-perfectionist": "5.10.1",
		"husky": "9.1.7",
		"lint-staged": "17.3.0",
		"typescript": "catalog:"
	},
	"homepage": "https://github.com/hallelujahdrive/katabami#readme",
	"keywords": [
		"combinator",
		"decoder",
		"json",
		"monorepo",
		"standard-schema",
		"typescript"
	],
	"license": "WTFPL",
	"name": "katabami-monorepo",
	"packageManager": "pnpm@11.20.0",
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/hallelujahdrive/katabami.git"
	},
	"scripts": {
		"build": "pnpm --filter katabami run build && pnpm --filter '@katabami/*' run build",
		"check": "biome check . && eslint .",
		"check:fix": "biome check --write . && eslint . --fix",
		"dpdm": "dpdm --exit-code circular:1 \"packages/*/src/index.ts\"",
		"format": "biome format . && eslint .",
		"format:fix": "biome format --write . && eslint . --fix",
		"lint": "biome lint . && eslint .",
		"lint:fix": "biome lint --write . && eslint . --fix",
		"prepare": "husky",
		"release": "node scripts/release.mjs",
		"test": "pnpm --filter './packages/*' run test",
		"test:typecheck": "pnpm --filter './packages/*' run test:typecheck",
		"types:check": "tsc --noEmit --pretty"
	},
	"type": "module",
	"version": "0.1.1-0"
}
